NODE_ENV="development" # set to production in HTTPS production environment to use Secure cookies
DATABASE_URL="" # PostgreSQL database connection URL. Please note for security reasons, this must NOT be a superuser or user with RLS bypass.
RESEND_API_KEY="" # Resend API key for email sending
BASE_URL="" # URL of app, used for safely generating site links in emails, eg http://localhost:3000

# to generate each secret below: openssl rand -hex 32
PEPPER="" # random secret added to passwords before hashing
ENCRYPTION_KEY="" # 32 bytes (64 hex chars) for AES-256-GCM email encryption and email lookup hashes
AUTH_TOKEN_SECRET="" # random secret used as the HMAC key for hashing short lived auth codes and tokens at rest (2FA email code, magic link login token, forgot password email code, forgot password reset token, authenticated password change code)
CSRF_SECRET="" # random secret used as the HMAC key for CSRF tokens
LOG_SECRET="" # random secret used as the HMAC key for audit log row hashes